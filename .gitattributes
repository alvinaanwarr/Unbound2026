import { useState } from "react";

const STAGES = [
  {
    id: "input",
    label: "01 / EVENT INPUT",
    title: "Organizer Drops the Brief",
    color: "electric",
    colorHex: "#00e5ff",
    icon: "⚡",
    fields: [
      { key: "location", label: "Event Location", example: "Toronto, ON" },
      { key: "duration", label: "Duration", example: "2-day hackathon" },
      { key: "theme", label: "Theme", example: "AI × Product Design" },
      { key: "field", label: "Field / Industry", example: "Tech, UX, Startups" },
      { key: "pitch", label: "Highlight Pitch", example: "Build real stuff. Meet real people." },
      { key: "audience", label: "Target Age Range", example: "16–24" },
      { key: "link", label: "Sign-Up Link", example: "lu.ma/your-event" },
    ],
    description: "Event organizers fill out a fast form. No fluff — just the essentials the AI needs to target and message the right people.",
  },
  {
    id: "targeting",
    label: "02 / AI TARGETING",
    title: "Find the Right People",
    color: "neon",
    colorHex: "#7c3aed",
    icon: "🎯",
    criteria: [
      { label: "Students with relevant interests but zero experience", tag: "HIGH PRIORITY" },
      { label: "Follows thought leaders in the target field", tag: "SIGNAL" },
      { label: "Age-matched to organizer's audience spec", tag: "FILTER" },
      { label: "Recent posts signal curiosity or career anxiety", tag: "PAIN POINT" },
      { label: "Existing connections from organizer's network", tag: "BUDDY MATCH" },
    ],
    description: "AI scans LinkedIn profiles, activity, and networks. Scores each person on fit, pain-point intensity, and buddy match potential.",
  },
  {
    id: "profile",
    label: "03 / PROFILE INTEL",
    title: "Read Their Whole Story",
    color: "gold",
    colorHex: "#f5c518",
    icon: "🔍",
    extractions: [
      "Current role / school & graduation year",
      "Listed skills vs. field skill gap analysis",
      "Recent activity: posts, likes, comments",
      "Followed orgs, communities, influencers",
      "Resume gaps or missing experience flags",
      "Mutual connections with event organizer",
    ],
    description: "For each shortlisted profile, the pipeline extracts raw intel that powers ultra-personalized messaging. No generic blasts.",
  },
  {
    id: "message",
    label: "04 / MESSAGE ENGINE",
    title: "The Rage-Bait Hook",
    color: "rage",
    colorHex: "#ff2d6b",
    icon: "💥",
    example: {
      name: "Priya S.",
      preview: `hey priya — noticed you've been learning figma for 8 months but your portfolio's still empty lol

not throwing shade, genuinely asking: what are you waiting for?

we're running a 2-day AI × design sprint in toronto and idk, sounds like exactly what you need to actually build something people will remember. not another course. actual projects. actual network.

you in? → lu.ma/designsprint`,
      tone: ["casual", "direct", "slightly provocative", "ends with clear CTA"],
    },
    description: "AI generates a personalized message that opens with their specific pain point — using intel from their profile — then pivots to what your event solves.",
  },
  {
    id: "followup",
    label: "05 / FOLLOW-UP",
    title: "If They Ghost or Say No",
    color: "green",
    colorHex: "#00ff88",
    icon: "🔁",
    paths: [
      {
        trigger: "No reply after 5 days",
        action: "Send soft bump — \"did this land in spam or is figma just not your thing anymore lol\"",
        tag: "AUTO BUMP",
      },
      {
        trigger: "Opens but doesn't click",
        action: "Send social proof — a real attendee story + 1 photo",
        tag: "PROOF SHOT",
      },
      {
        trigger: "Declines",
        action: "\"totally fair — can I ask why? genuinely want to know if we're missing something\"",
        tag: "WHY LOOP",
      },
      {
        trigger: "Buddy match found",
        action: "\"btw [name from their network] is coming — thought you should know\"",
        tag: "BUDDY DROP",
      },
    ],
    description: "The pipeline doesn't die at the first reply. Each response (or silence) triggers the right next action automatically.",
  },
  {
    id: "output",
    label: "06 / OUTPUT SHEET",
    title: "The Organizer's Dashboard",
    color: "electric",
    colorHex: "#00e5ff",
    icon: "📊",
    columns: [
      { col: "Name + LinkedIn", note: "linked profile" },
      { col: "Fit Score", note: "0–100 AI rank" },
      { col: "Pain Point", note: "AI-detected" },
      { col: "Message Sent", note: "full text" },
      { col: "Status", note: "opened / clicked / signed up / rejected" },
      { col: "Rejection Reason", note: "from 'why?' loop" },
      { col: "Buddy Match", note: "suggested pairing" },
      { col: "Follow-Up Sent", note: "timestamp + type" },
    ],
    description: "Every touchpoint tracked. Organizers see who got what message, what happened, and why people dropped off — in one clean sheet.",
  },
];

const colorMap: Record<string, string> = {
  electric: "border-[#00e5ff]/30 hover:border-[#00e5ff]/60",
  neon: "border-[#7c3aed]/30 hover:border-[#7c3aed]/60",
  rage: "border-[#ff2d6b]/30 hover:border-[#ff2d6b]/60",
  gold: "border-[#f5c518]/30 hover:border-[#f5c518]/60",
  green: "border-[#00ff88]/30 hover:border-[#00ff88]/60",
};

const bgMap: Record<string, string> = {
  electric: "bg-[#00e5ff]/10",
  neon: "bg-[#7c3aed]/10",
  rage: "bg-[#ff2d6b]/10",
  gold: "bg-[#f5c518]/10",
  green: "bg-[#00ff88]/10",
};

const textMap: Record<string, string> = {
  electric: "text-[#00e5ff]",
  neon: "text-[#7c3aed]",
  rage: "text-[#ff2d6b]",
  gold: "text-[#f5c518]",
  green: "text-[#00ff88]",
};

const glowMap: Record<string, string> = {
  electric: "glow-electric",
  neon: "glow-neon",
  rage: "glow-rage",
  gold: "",
  green: "glow-green",
};

export default function App() {
  const [active, setActive] = useState<string | null>("message");

  return (
    <div className="min-h-screen" style={{ backgroundColor: "#080b12", fontFamily: "'Outfit', sans-serif" }}>
      {/* Header */}
      <header className="border-b border-[#1e2840] px-6 py-4 flex items-center justify-between sticky top-0 z-50" style={{ backgroundColor: "#080b12ee", backdropFilter: "blur(12px)" }}>
        <div className="flex items-center gap-3">
          <div className="w-7 h-7 rounded flex items-center justify-center text-xs" style={{ background: "linear-gradient(135deg, #00e5ff, #7c3aed)" }}>
            <span style={{ fontFamily: "'JetBrains Mono', monospace" }}>⚡</span>
          </div>
          <span className="font-bold tracking-tight text-white" style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: "14px" }}>
            REACHFAST
          </span>
          <span className="text-[10px] px-2 py-0.5 rounded-full border border-[#2a3655] text-[#4a5880]" style={{ fontFamily: "'JetBrains Mono', monospace" }}>
            PIPELINE v1
          </span>
        </div>
        <div className="flex items-center gap-4 text-[12px]" style={{ color: "#4a5880", fontFamily: "'JetBrains Mono', monospace" }}>
          <span className="animate-pulse-glow" style={{ color: "#00ff88" }}>● LIVE</span>
          <span>LinkedIn Outreach Automation</span>
        </div>
      </header>

      <main className="max-w-6xl mx-auto px-4 sm:px-6 py-12">
        {/* Hero */}
        <section className="mb-16">
          <p className="text-[11px] tracking-[0.25em] mb-8 text-center" style={{ fontFamily: "'JetBrains Mono', monospace", color: "#4a5880" }}>
            AUTOMATED EVENT OUTREACH PIPELINE
          </p>

          {/* Builder pitch narrative */}
          <div className="rounded-2xl p-6 mb-8" style={{ backgroundColor: "#0e1320", border: "1px solid #1e2840" }}>
            <p className="text-[11px] tracking-[0.2em] mb-4" style={{ fontFamily: "'JetBrains Mono', monospace", color: "#4a5880" }}>
              PICTURE THIS
            </p>
            <p className="text-lg leading-relaxed mb-3" style={{ color: "#c8d6f0" }}>
              You&apos;re a builder. You just planned{" "}
              <span className="font-bold text-white">5 events for the upcoming month.</span>{" "}
              Now you&apos;re staring down a task that&apos;s going to eat your entire week — posting on LinkedIn, manually messaging hundreds of people one by one, just hoping they sign up.
            </p>
            <p className="text-lg leading-relaxed mb-3" style={{ color: "#c8d6f0" }}>
              Copy-paste the name. Tweak the opener. Hit send. Repeat.{" "}
              <span style={{ color: "#6b7fa8" }}>300 times.</span>
            </p>
            <p className="text-lg leading-relaxed font-semibold" style={{ color: "#ffffff" }}>
              What if all of that was done for you{" "}
              <span style={{ color: "#00e5ff" }}>in a single day</span> — and you could turn the whole pipeline into a{" "}
              <span style={{ color: "#00e5ff" }}>business that other event hosts pay to use?</span>
            </p>
          </div>

          <div className="flex items-center gap-4 mb-8 justify-center">
            <span className="text-3xl font-black" style={{ color: "#2a3655" }}>. . .</span>
            <span className="text-xl font-bold italic" style={{ color: "#ff2d6b" }}>Silly you.</span>
            <span className="text-xl font-bold text-white">We already made it.</span>
          </div>

          <h1 className="font-black mb-4 leading-none text-center" style={{ fontSize: "clamp(2.5rem, 6vw, 5rem)", color: "#ffffff" }}>
            Welcome to{" "}
            <span className="text-shimmer">REACH FAST.</span>
          </h1>
          <p className="text-center max-w-xl mx-auto leading-relaxed mb-8" style={{ color: "#6b7fa8", fontSize: "1.05rem" }}>
            AI reads every LinkedIn profile, detects their exact career anxiety, writes a message that hits, sends it, follows up, and hands you a sheet of warm leads — automatically.
          </p>
          <div className="flex flex-wrap justify-center gap-4 text-[12px]" style={{ fontFamily: "'JetBrains Mono', monospace", color: "#4a5880" }}>
            {["PERSONALIZED AT SCALE", "RAGE-BAIT HOOKS", "BUDDY MATCHING", "AUTO FOLLOW-UP"].map((tag) => (
              <span key={tag} className="flex items-center gap-1.5">
                <span style={{ color: "#00e5ff" }}>—</span> {tag}
              </span>
            ))}
          </div>
        </section>

        {/* Pipeline Flow */}
        <section className="mb-16">
          <div className="flex items-center gap-3 mb-8">
            <span className="text-[11px] tracking-[0.2em]" style={{ fontFamily: "'JetBrains Mono', monospace", color: "#4a5880" }}>
              THE PIPELINE
            </span>
            <div className="flex-1 h-px" style={{ background: "linear-gradient(to right, #1e2840, transparent)" }} />
          </div>

          {/* Stage Cards */}
          <div className="grid gap-3">
            {STAGES.map((stage, i) => {
              const isActive = active === stage.id;
              return (
                <div key={stage.id} className="relative">
                  {/* Connector line */}
                  {i < STAGES.length - 1 && (
                    <div
                      className="absolute left-8 bottom-0 w-px z-10"
                      style={{
                        height: "12px",
                        marginBottom: "-12px",
                        background: `linear-gradient(to bottom, ${stage.colorHex}40, transparent)`,
                      }}
                    />
                  )}

                  <button
                    onClick={() => setActive(isActive ? null : stage.id)}
                    className={`w-full text-left rounded-xl border transition-all duration-300 overflow-hidden ${colorMap[stage.color]}`}
                    style={{ backgroundColor: "#0e1320" }}
                  >
                    {/* Card Header */}
                    <div className="flex items-center gap-4 px-6 py-4">
                      <div
                        className={`w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 text-lg transition-all ${isActive ? bgMap[stage.color] : ""}`}
                        style={{ border: `1px solid ${stage.colorHex}25` }}
                      >
                        {stage.icon}
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="flex items-center gap-3 mb-0.5">
                          <span
                            className="text-[10px] tracking-[0.2em]"
                            style={{ fontFamily: "'JetBrains Mono', monospace", color: stage.colorHex }}
                          >
                            {stage.label}
                          </span>
                        </div>
                        <h3 className="font-bold text-white text-base leading-tight">{stage.title}</h3>
                      </div>
                      <div className="flex-shrink-0">
                        <div
                          className="w-5 h-5 rounded-full border flex items-center justify-center transition-transform duration-300"
                          style={{
                            borderColor: isActive ? stage.colorHex : "#2a3655",
                            transform: isActive ? "rotate(45deg)" : "rotate(0deg)",
                          }}
                        >
                          <span style={{ color: isActive ? stage.colorHex : "#4a5880", fontSize: "10px", lineHeight: 1 }}>+</span>
                        </div>
                      </div>
                    </div>

                    {/* Expanded Content */}
                    {isActive && (
                      <div className="px-6 pb-6 animate-slide-in">
                        <div
                          className="h-px mb-5"
                          style={{ background: `linear-gradient(to right, ${stage.colorHex}30, transparent)` }}
                        />
                        <p className="mb-5 text-sm leading-relaxed" style={{ color: "#6b7fa8" }}>
                          {stage.description}
                        </p>

                        {/* Input Stage */}
                        {stage.id === "input" && (
                          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            {stage.fields!.map((f) => (
                              <div key={f.key} className="rounded-lg p-3" style={{ backgroundColor: "#080b12", border: "1px solid #1e2840" }}>
                                <div className="text-[10px] mb-1" style={{ fontFamily: "'JetBrains Mono', monospace", color: "#4a5880" }}>
                                  {f.label.toUpperCase()}
                                </div>
                                <div className="text-sm" style={{ color: "#c8d6f0" }}>{f.example}</div>
                              </div>
                            ))}
                          </div>
                        )}

                        {/* Targeting Stage */}
                        {stage.id === "targeting" && (
                          <div className="flex flex-col gap-2">
                            {stage.criteria!.map((c, idx) => (
                              <div
                                key={idx}
                                className="flex items-center justify-between rounded-lg px-4 py-3"
                                style={{ backgroundColor: "#080b12", border: "1px solid #1e2840" }}
                              >
                                <span className="text-sm" style={{ color: "#c8d6f0" }}>{c.label}</span>
                                <span
                                  className="text-[9px] px-2 py-0.5 rounded-full ml-3 flex-shrink-0"
                                  style={{
                                    fontFamily: "'JetBrains Mono', monospace",
                                    color: stage.colorHex,
                                    border: `1px solid ${stage.colorHex}40`,
                                    backgroundColor: `${stage.colorHex}10`,
                                  }}
                                >
                                  {c.tag}
                                </span>
                              </div>
                            ))}
                          </div>
                        )}

                        {/* Profile Stage */}
                        {stage.id === "profile" && (
                          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            {stage.extractions!.map((e, idx) => (
                              <div key={idx} className="flex items-start gap-2 text-sm" style={{ color: "#c8d6f0" }}>
                                <span style={{ color: "#f5c518", fontSize: "10px", marginTop: "4px" }}>▸</span>
                                {e}
                              </div>
                            ))}
                          </div>
                        )}

                        {/* Message Stage */}
                        {stage.id === "message" && (
                          <div>
                            <div className="flex gap-2 mb-3 flex-wrap">
                              {stage.example!.tone.map((t) => (
                                <span
                                  key={t}
                                  className="text-[9px] px-2 py-0.5 rounded-full"
                                  style={{
                                    fontFamily: "'JetBrains Mono', monospace",
                                    color: "#ff2d6b",
                                    border: "1px solid #ff2d6b40",
                                    backgroundColor: "#ff2d6b10",
                                  }}
                                >
                                  {t}
                                </span>
                              ))}
                            </div>
                            <div
                              className="rounded-xl p-5"
                              style={{
                                backgroundColor: "#080b12",
                                border: "1px solid #ff2d6b30",
                                fontFamily: "'JetBrains Mono', monospace",
                              }}
                            >
                              <div className="text-[10px] mb-3" style={{ color: "#4a5880" }}>
                                GENERATED FOR → {stage.example!.name}
                              </div>
                              <pre
                                className="text-sm leading-relaxed whitespace-pre-wrap"
                                style={{ color: "#c8d6f0", fontFamily: "'JetBrains Mono', monospace" }}
                              >
                                {stage.example!.preview}
                              </pre>
                            </div>
                          </div>
                        )}

                        {/* Follow-up Stage */}
                        {stage.id === "followup" && (
                          <div className="grid gap-3">
                            {stage.paths!.map((p, idx) => (
                              <div
                                key={idx}
                                className="rounded-lg p-4"
                                style={{ backgroundColor: "#080b12", border: "1px solid #1e2840" }}
                              >
                                <div className="flex items-center gap-2 mb-2">
                                  <span
                                    className="text-[9px] px-2 py-0.5 rounded-full"
                                    style={{
                                      fontFamily: "'JetBrains Mono', monospace",
                                      color: "#00ff88",
                                      border: "1px solid #00ff8840",
                                      backgroundColor: "#00ff8810",
                                    }}
                                  >
                                    {p.tag}
                                  </span>
                                  <span className="text-[10px]" style={{ color: "#4a5880" }}>IF: {p.trigger}</span>
                                </div>
                                <p className="text-sm italic" style={{ color: "#c8d6f0" }}>"{p.action}"</p>
                              </div>
                            ))}
                          </div>
                        )}

                        {/* Output Stage */}
                        {stage.id === "output" && (
                          <div className="overflow-x-auto">
                            <table className="w-full text-sm">
                              <thead>
                                <tr style={{ borderBottom: "1px solid #1e2840" }}>
                                  <th
                                    className="text-left pb-2 pr-4 text-[10px] tracking-widest"
                                    style={{ fontFamily: "'JetBrains Mono', monospace", color: "#4a5880" }}
                                  >
                                    COLUMN
                                  </th>
                                  <th
                                    className="text-left pb-2 text-[10px] tracking-widest"
                                    style={{ fontFamily: "'JetBrains Mono', monospace", color: "#4a5880" }}
                                  >
                                    CONTAINS
                                  </th>
                                </tr>
                              </thead>
                              <tbody>
                                {stage.columns!.map((c, idx) => (
                                  <tr
                                    key={idx}
                                    style={{ borderBottom: "1px solid #1e284050" }}
                                  >
                                    <td className="py-2 pr-4 font-medium" style={{ color: "#c8d6f0" }}>{c.col}</td>
                                    <td className="py-2" style={{ color: "#4a5880", fontFamily: "'JetBrains Mono', monospace", fontSize: "11px" }}>{c.note}</td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        )}
                      </div>
                    )}
                  </button>
                </div>
              );
            })}
          </div>
        </section>

        {/* LinkedIn ToS section */}
        <section className="mb-16">
          <div className="flex items-center gap-3 mb-8">
            <span className="text-[11px] tracking-[0.2em]" style={{ fontFamily: "'JetBrains Mono', monospace", color: "#ff2d6b" }}>
              THE COMPLIANCE QUESTION
            </span>
            <div className="flex-1 h-px" style={{ background: "linear-gradient(to right, #ff2d6b30, transparent)" }} />
          </div>

          {/* Warning banner */}
          <div className="rounded-xl px-5 py-4 mb-6 flex items-start gap-4" style={{ backgroundColor: "#1a0a0f", border: "1px solid #ff2d6b40" }}>
            <span className="text-xl flex-shrink-0 mt-0.5">⚠️</span>
            <div>
              <p className="font-bold text-white mb-1">LinkedIn automation is against LinkedIn&apos;s User Agreement.</p>
              <p className="text-sm leading-relaxed" style={{ color: "#6b7fa8" }}>
                Auto-DMs, profile scraping, and mass auto-connects all violate LinkedIn ToS §8.2 and can result in account restrictions or permanent bans. Here&apos;s exactly how we handle that — and why addressing it head-on is a competitive advantage.
              </p>
            </div>
          </div>

          {/* Risks */}
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
            {[
              { risk: "Auto-DMs", detail: "Sending automated messages at scale triggers spam detection and violates ToS §8.2." },
              { risk: "Profile scraping", detail: "Bots or headless browsers extracting profile data violate ToS regardless of public visibility." },
              { risk: "Mass auto-connect", detail: "Bulk connection requests from one account get flagged and rate-limited within hours." },
            ].map((r) => (
              <div key={r.risk} className="rounded-xl p-4" style={{ backgroundColor: "#0e1320", border: "1px solid #ff2d6b25" }}>
                <div className="flex items-center gap-2 mb-2">
                  <span className="w-1.5 h-1.5 rounded-full flex-shrink-0" style={{ backgroundColor: "#ff2d6b" }} />
                  <p className="text-sm font-bold text-white">{r.risk}</p>
                  <span className="ml-auto text-[9px] px-1.5 py-0.5 rounded" style={{ fontFamily: "'JetBrains Mono', monospace", color: "#ff2d6b", border: "1px solid #ff2d6b40", backgroundColor: "#ff2d6b10" }}>RESTRICTED</span>
                </div>
                <p className="text-xs leading-relaxed" style={{ color: "#6b7fa8" }}>{r.detail}</p>
              </div>
            ))}
          </div>

          {/* Our guardrails */}
          <p className="text-[11px] tracking-[0.2em] mb-4" style={{ fontFamily: "'JetBrains Mono', monospace", color: "#00e5ff" }}>
            HOW WE HANDLE IT
          </p>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
            {[
              {
                color: "#00e5ff",
                tag: "HUMAN IN THE LOOP",
                title: "Queue, don't auto-fire",
                body: "ReachFast generates the message and identifies the target — but a human clicks send. Outreach stays within LinkedIn's manual-use guidelines. Every send is a conscious approval.",
              },
              {
                color: "#00e5ff",
                tag: "AUTHORIZED DATA ACCESS",
                title: "API + licensed providers only",
                body: "We use LinkedIn's official API or authorized third-party data providers (e.g. Proxycurl, Apollo) with their own data licensing. No scraping bots, no headless browsers.",
              },
              {
                color: "#f5c518",
                tag: "CHANNEL FALLBACK",
                title: "Own the channel where possible",
                body: "For high-volume campaigns we export a personalized message list and let organizers send via their own account, or redirect to email and Discord — channels we fully control.",
              },
              {
                color: "#7c3aed",
                tag: "PITCH ANGLE",
                title: "Compliance is the moat",
                body: "Competitors skip this slide. We name it, show our guardrails, and position it as why enterprise orgs trust ReachFast over DIY scrapers that put their LinkedIn accounts at risk.",
              },
            ].map((g) => (
              <div key={g.title} className="rounded-xl p-4" style={{ backgroundColor: "#0e1320", border: `1px solid ${g.color}25` }}>
                <span className="inline-block text-[9px] px-2 py-0.5 rounded mb-3" style={{ fontFamily: "'JetBrains Mono', monospace", color: g.color, border: `1px solid ${g.color}40`, backgroundColor: `${g.color}10` }}>{g.tag}</span>
                <p className="text-sm font-bold text-white mb-1.5">{g.title}</p>
                <p className="text-xs leading-relaxed" style={{ color: "#6b7fa8" }}>{g.body}</p>
              </div>
            ))}
          </div>

          <div className="rounded-lg px-4 py-3 text-xs text-center font-semibold" style={{ fontFamily: "'JetBrains Mono', monospace", backgroundColor: "#00e5ff10", border: "1px solid #00e5ff30", color: "#00e5ff" }}>
            GUARDRAIL: use only permitted / authorized data access — keep a human approval in the loop at all times
          </div>
        </section>

        {/* Philosophy section */}
        <section className="mb-16">
          <div className="flex items-center gap-3 mb-8">
            <span className="text-[11px] tracking-[0.2em]" style={{ fontFamily: "'JetBrains Mono', monospace", color: "#4a5880" }}>
              THE PHILOSOPHY
            </span>
            <div className="flex-1 h-px" style={{ background: "linear-gradient(to right, #1e2840, transparent)" }} />
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {[
              {
                color: "#00e5ff",
                title: "Don't be a newsletter",
                body: "Email blasts are dead to Gen Z. We talk like a person, not a brand. First message is casual, slightly edgy — zero corporate speak.",
              },
              {
                color: "#ff2d6b",
                title: "Hit the pain point first",
                body: "Every message opens by naming something real from their profile. Not a fake compliment. A mirror. Then we offer the escape hatch.",
              },
              {
                color: "#00ff88",
                title: "Just Do Things",
                body: "We specifically target people with interest but zero experience. The message is: you don't need to be qualified to show up. Just come.",
              },
            ].map((p) => (
              <div
                key={p.title}
                className="rounded-xl p-5"
                style={{
                  backgroundColor: "#0e1320",
                  border: `1px solid ${p.color}25`,
                }}
              >
                <div className="w-1 h-6 rounded mb-4" style={{ backgroundColor: p.color }} />
                <h4 className="font-bold text-white mb-2">{p.title}</h4>
                <p className="text-sm leading-relaxed" style={{ color: "#6b7fa8" }}>{p.body}</p>
              </div>
            ))}
          </div>
        </section>

        {/* Buddy Program */}
        <section className="mb-16">
          <div
            className="rounded-2xl p-8 relative overflow-hidden"
            style={{
              backgroundColor: "#0e1320",
              border: "1px solid #7c3aed40",
            }}
          >
            <div
              className="absolute top-0 right-0 w-64 h-64 rounded-full pointer-events-none"
              style={{
                background: "radial-gradient(circle, #7c3aed15 0%, transparent 70%)",
                transform: "translate(30%, -30%)",
              }}
            />
            <div className="relative">
              <span className="text-[10px] tracking-[0.2em]" style={{ fontFamily: "'JetBrains Mono', monospace", color: "#7c3aed" }}>
                BUDDY PROGRAM
              </span>
              <h3 className="text-2xl font-black text-white mt-2 mb-3">
                "btw [mutual connection] is going"
              </h3>
              <p className="max-w-xl leading-relaxed" style={{ color: "#6b7fa8" }}>
                The pipeline cross-references each target's LinkedIn connections against the event's confirmed attendee list. If there's a match, the follow-up message drops the buddy's name. Nothing converts faster than social proof from someone they already know.
              </p>
              <div className="flex gap-6 mt-6">
                {[
                  { stat: "3×", label: "higher open rate" },
                  { stat: "2.4×", label: "more sign-ups" },
                  { stat: "↓61%", label: "no-show rate" },
                ].map((s) => (
                  <div key={s.stat}>
                    <div className="text-2xl font-black" style={{ color: "#7c3aed" }}>{s.stat}</div>
                    <div className="text-xs" style={{ color: "#4a5880" }}>{s.label}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        {/* Footer */}
        <footer className="border-t border-[#1e2840] pt-8 flex items-center justify-between">
          <span style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: "11px", color: "#2a3655" }}>
            REACHFAST PIPELINE — OUTREACH AUTOMATION
          </span>
          <span style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: "11px", color: "#2a3655" }}>
            v1.0 / SEPT 2026
          </span>
        </footer>
      </main>
    </div>
  );
}
